# Copy to .env for local dev — never commit real values.
# Every variable is documented in docs/ops/environments.md. Tests must NEVER run
# against a remote DATABASE_URL: `pnpm test:e2e` refuses to (test/require-local-db.cjs).

NODE_ENV=development
PORT=4000

# pino log level (trace|debug|info|warn|error). Optional; default info.
LOG_LEVEL=info

# docker = local Postgres/Redis + custom JWT auth + Socket.IO realtime (this file's
# defaults). supabase = Supabase-hosted Postgres/Auth/Realtime/Storage — requires the
# SUPABASE_* vars below. Redis/BullMQ jobs are unaffected either way (platform-mode plan §1).
PLATFORM_MODE=docker

# Local dev: docker-compose.yml postgres service. Supabase mode: the Session Mode
# pooler connection string from Project Settings → Database → Connection pooling —
# NOT the direct db.<ref>.supabase.co host, which resolves IPv6-only and is
# unreachable from IPv4-only networks. Add ?connect_timeout=20 too: the pooler's
# extra hop needs longer than Prisma's default connect timeout on some routes.
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connect_timeout=20
DATABASE_URL=postgresql://packetpulse:packetpulse@localhost:5433/packetpulse

REDIS_URL=redis://localhost:6380

# Required only when PLATFORM_MODE=supabase — Project Settings → API in the Supabase
# dashboard. SUPABASE_SECRET_KEY is the current "secret key" (sb_secret_...), the
# replacement for the legacy service_role key — no JWT secret needed since our own
# JWT_ACCESS_SECRET still signs session tokens in both modes (plan §2).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Session limits (SEC-05) and login lockout (TASK-013); the values shown are the defaults.
SESSION_MEMBER_IDLE_MINUTES=43200
SESSION_STAFF_IDLE_MINUTES=30
SESSION_STAFF_ABSOLUTE_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Generate with: openssl rand -hex 32 — asserted non-empty at boot (plan §11)
ADMIN_SECURE_CODE=

# Comma-separated explicit allowlist — never "*" (plan §11)
CORS_ORIGINS=http://localhost:3000

# Base URL of the deployed frontend — used to build the clickable link in the
# verification email.
FRONTEND_URL=http://localhost:3000

# Preferred: Resend HTTPS API key — used instead of SMTP_* when set (Render's free
# plan blocks outbound SMTP ports 25/465/587).
RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Bot protection (TASK-013): Cloudflare Turnstile SECRET key. Unset = captcha disabled.
# Set together with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the web app. See docs/ops/bot-protection.md.
TURNSTILE_SECRET_KEY=

# Which proxies to trust for the client IP (finding S-11): true | false | hop count | IP/CIDR list.
# Unset = true (trust every proxy; client IPs can be spoofed). See docs/ops/bot-protection.md.
TRUST_PROXY=

# Background-job alerts (TASK-016): optional webhook (Slack/Discord/any JSON endpoint) called when
# a job fails for good, stalls, or a worker errors. Unset = off (the structured log line is
# always written). Max one message per minute per queue; payload has no addresses or message bodies.
ALERT_WEBHOOK_URL=
