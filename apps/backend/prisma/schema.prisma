// Identity domain (Phase 1) — users, multi-role RBAC, and token/verification tables.
// Content domains (Phase 2) — blogs, resources, recordings.
// New features (Phase 3) — forums, quizzes/certificates (plan §2).
generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the musl-openssl-3.0.x engine is what Docker's
  // node:24-alpine runtime image needs (Alpine ships OpenSSL 3.x, not 1.1 —
  // the default musl target ships a libssl.so.1.1-linked engine that fails to
  // load at all on modern Alpine, caught by actually running the built
  // container, not just building it).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfessionalExperience {
  student
  junior
  mid
  senior
  lead
}

model User {
  id                     String    @id @default(uuid())
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  whatsappNumber         String?   @map("whatsapp_number")
  professionalExperience ProfessionalExperience? @map("professional_experience")
  avatarUrl              String?   @map("avatar_url")
  bio                    String?

  // Approval is orthogonal to role — an unapproved user has no access regardless
  // of role (plan §4). Requires emailVerified before an admin can approve (plan §4).
  isApproved  Boolean   @default(false) @map("is_approved")
  approvedById String?  @map("approved_by_id")
  approvedBy   User?    @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]  @relation("UserApprovals")
  approvedAt   DateTime? @map("approved_at")

  emailVerified Boolean  @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  certifications      UserCertification[]
  socialLinks         UserSocialLinks?
  refreshTokens        RefreshToken[]
  passwordResets        PasswordReset[]
  emailVerifications     EmailVerification[]
  roles                 UserRole[]

  blogPosts            BlogPost[]
  blogComments         BlogComment[]
  blogLikes            BlogLike[]
  resources            Resource[]
  resourceLikes        ResourceLike[]
  recordingsAsInstructor Recording[]
  recordingParticipations RecordingParticipant[]
  recordingLikes       RecordingLike[]

  forumThreads         ForumThread[]
  forumReplies         ForumReply[]
  forumReplyLikes      ForumReplyLike[]
  quizzesCreated       Quiz[]
  quizAttempts         QuizAttempt[]
  certificates         Certificate[]
  notifications        Notification[]
  activityLogActions   AdminActivityLog[]

  @@map("users")
}

model UserCertification {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  issueDate        DateTime? @map("issue_date")
  expiryDate       DateTime? @map("expiry_date")
  verificationUrl  String?   @map("verification_url")

  @@index([userId])
  @@map("user_certifications")
}

// Fixed known columns, not a free-form JSON blob — replaces the old Mongoose
// socialLinks{} ad hoc object (plan §2 JSONB-vs-relational criteria).
model UserSocialLinks {
  id        String @id @default(uuid())
  userId    String @unique @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedin  String?
  github    String?
  twitter   String?
  website   String?

  @@map("user_social_links")
}

// Refresh tokens are stored server-side as a hash (not a bare re-signed JWT like the
// old app) so they can be genuinely revoked, and rotated with reuse detection: presenting
// an already-rotated token revokes the whole family (replayAttack defense, plan §4).
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @map("token_hash")
  familyId      String    @map("family_id") // shared across a rotation chain — revoking one revokes the family
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedById  String?   @unique @map("replaced_by_id")
  replacedBy    RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  previousToken RefreshToken? @relation("TokenRotation")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

// OTP-based reset (6-digit, hashed, 10-minute expiry) — kept from the old app's UX,
// reimplemented against its own table instead of overloading columns on User (plan §4).
model PasswordReset {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_resets")
}

// New — the old app never verified email despite having an unused emailVerified field.
// Single-use, 24h-expiry, hashed token (plan §4).
model EmailVerification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("email_verifications")
}

// Multi-role RBAC — replaces the old flat member/admin enum. RolesGuard checks
// permissions, not raw role names, so adding a role later never touches guard logic,
// only role_permissions seed data (plan §4).
model Role {
  id          String    @id @default(uuid())
  name        String    @unique // member | moderator | instructor | admin | super_admin
  description String?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id   String @id @default(uuid())
  key  String @unique // e.g. "blogs:publish", "forums:moderate", "users:approve"

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A user can hold multiple roles at once (e.g. instructor + moderator), not just one (plan §4).
model UserRole {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Content domains (Phase 2): blogs, resources, recordings.
// Comments/likes/tags/participants are first-class join/child tables with FKs
// — no embedded arrays, replacing Mongoose's embedded-document pattern (plan §2).
// ---------------------------------------------------------------------------

enum BlogCategory {
  ccna
  ccnp
  network_automation
  security
  sdn
  ipv6
  general
}

model BlogPost {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  content    String
  authorId   String   @map("author_id")
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  coverImageUrl String? @map("cover_image_url")
  category   BlogCategory @default(general)
  viewCount  Int      @default(0) @map("view_count")
  isPublished Boolean @default(true) @map("is_published")
  // Moderation gate, added alongside Resource/Recording's existing isApproved (same
  // default-true semantics — most posts pass through, admin moderation queue is
  // opt-in via manually flagging a post false, mirroring the resources/recordings
  // pattern rather than gating every new post behind approval).
  isApproved Boolean @default(true) @map("is_approved")
  postedAt   DateTime @default(now()) @map("posted_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tags     BlogPostTag[]
  images   BlogPostImage[]
  comments BlogComment[]
  likes    BlogLike[]

  @@index([category])
  @@index([isPublished, postedAt])
  @@index([isApproved])
  @@map("blog_posts")
}

model BlogPostTag {
  blogPostId String   @map("blog_post_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        String

  @@id([blogPostId, tag])
  @@index([tag])
  @@map("blog_post_tags")
}

model BlogPostImage {
  id         String   @id @default(uuid())
  blogPostId String   @map("blog_post_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  url        String
  position   Int      @default(0)

  @@index([blogPostId])
  @@map("blog_post_images")
}

model BlogComment {
  id         String   @id @default(uuid())
  blogPostId String   @map("blog_post_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([blogPostId, createdAt])
  @@map("blog_comments")
}

model BlogLike {
  blogPostId String   @map("blog_post_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([blogPostId, userId])
  @@index([userId])
  @@map("blog_likes")
}

enum ResourceType {
  pdf
  video
  article
  tutorial
  diagram
  config_template
  tool
  external_link
}

enum ResourceCategory {
  ccna
  ccnp
  network_automation
  security
  sdn
  ipv6
  general
}

model Resource {
  id             String   @id @default(uuid())
  title          String
  description    String
  resourceType   ResourceType @map("resource_type")
  category       ResourceCategory
  fileUrl        String?  @map("file_url")
  externalLink   String?  @map("external_link")
  thumbnailUrl   String?  @map("thumbnail_url")
  downloadable   Boolean  @default(true)
  premium        Boolean  @default(false)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloads      Int      @default(0)
  views          Int      @default(0)
  isFeatured     Boolean  @default(false) @map("is_featured")
  isApproved     Boolean  @default(true) @map("is_approved")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tags  ResourceTag[]
  likes ResourceLike[]

  @@index([category])
  @@index([resourceType])
  @@index([isApproved, premium])
  @@map("resources")
}

model ResourceTag {
  resourceId String   @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        String

  @@id([resourceId, tag])
  @@index([tag])
  @@map("resource_tags")
}

model ResourceLike {
  resourceId String   @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([resourceId, userId])
  @@index([userId])
  @@map("resource_likes")
}

enum RecordingCategory {
  ccna
  ccnp
  network_automation
  security
  sdn
  ipv6
  general
}

model Recording {
  id             String   @id @default(uuid())
  title          String
  description    String
  recordingUrl   String   @map("recording_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  durationSeconds Int     @default(0) @map("duration_seconds")
  category       RecordingCategory
  instructorId   String   @map("instructor_id")
  instructor     User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  premium        Boolean  @default(false)
  isFeatured     Boolean  @default(true) @map("is_featured")
  isApproved     Boolean  @default(true) @map("is_approved")
  views          Int      @default(0)
  recordedAt     DateTime @default(now()) @map("recorded_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tags         RecordingTag[]
  participants RecordingParticipant[]
  likes        RecordingLike[]

  @@index([category])
  @@index([isApproved, premium])
  @@map("recordings")
}

model RecordingTag {
  recordingId String    @map("recording_id")
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  tag         String

  @@id([recordingId, tag])
  @@index([tag])
  @@map("recording_tags")
}

model RecordingParticipant {
  recordingId String    @map("recording_id")
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now()) @map("joined_at")

  @@id([recordingId, userId])
  @@index([userId])
  @@map("recording_participants")
}

model RecordingLike {
  recordingId String    @map("recording_id")
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([recordingId, userId])
  @@index([userId])
  @@map("recording_likes")
}

// ---------------------------------------------------------------------------
// Forums (Phase 3, NEW) — no backend model ever existed for this in the old app,
// designed from scratch (plan §2/§3).
// ---------------------------------------------------------------------------

model ForumCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  position    Int      @default(0)

  threads ForumThread[]

  @@map("forum_categories")
}

model ForumThread {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    String   @map("author_id")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  content     String
  slug        String
  isPinned    Boolean  @default(false) @map("is_pinned")
  isLocked    Boolean  @default(false) @map("is_locked")
  viewCount   Int      @default(0) @map("view_count")
  // Denormalized cache, recomputable from replies.count — not authoritative state (plan §2).
  replyCount  Int      @default(0) @map("reply_count")
  lastReplyAt DateTime @default(now()) @map("last_reply_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  replies ForumReply[]

  @@unique([categoryId, slug])
  @@index([categoryId, lastReplyAt])
  @@map("forum_threads")
}

model ForumReply {
  id             String   @id @default(uuid())
  threadId       String   @map("thread_id")
  thread         ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId       String   @map("author_id")
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  parentReplyId  String?  @map("parent_reply_id")
  parentReply    ForumReply?  @relation("ReplyNesting", fields: [parentReplyId], references: [id], onDelete: SetNull)
  childReplies   ForumReply[] @relation("ReplyNesting")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  editedAt       DateTime? @map("edited_at")

  likes ForumReplyLike[]

  @@index([threadId, createdAt])
  @@map("forum_replies")
}

model ForumReplyLike {
  replyId   String     @map("reply_id")
  reply     ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@id([replyId, userId])
  @@index([userId])
  @@map("forum_reply_likes")
}

// ---------------------------------------------------------------------------
// Quizzes/Certificates (Phase 3, NEW) — old app only had leftover admin-cleanup
// references to a "quizzes" data type; no real feature ever existed. Designed
// from scratch (plan §2/§3).
// ---------------------------------------------------------------------------

enum QuizQuestionType {
  single_choice
  multi_choice
}

enum QuizAttemptStatus {
  in_progress
  submitted
  expired
}

model Quiz {
  id                String   @id @default(uuid())
  title             String
  description       String
  category          BlogCategory @default(general)
  passingScorePct   Int      @default(70) @map("passing_score_pct")
  timeLimitSeconds  Int?     @map("time_limit_seconds")
  isPublished       Boolean  @default(false) @map("is_published")
  createdById       String   @map("created_by_id")
  createdBy         User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  certificates Certificate[]

  @@index([isPublished, category])
  @@map("quizzes")
}

model QuizQuestion {
  id           String   @id @default(uuid())
  quizId       String   @map("quiz_id")
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String   @map("question_text")
  questionType QuizQuestionType @map("question_type")
  position     Int      @default(0)
  points       Int      @default(1)

  options QuizQuestionOption[]
  answers QuizAttemptAnswer[]

  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizQuestionOption {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String   @map("option_text")
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int      @default(0)

  @@index([questionId])
  @@map("quiz_question_options")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String   @map("quiz_id")
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  scorePct    Int?     @map("score_pct")
  passed      Boolean?
  status      QuizAttemptStatus @default(in_progress)

  answers     QuizAttemptAnswer[]
  certificate Certificate?

  @@index([userId, quizId])
  @@index([status])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id                String   @id @default(uuid())
  attemptId         String   @map("attempt_id")
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String   @map("question_id")
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Fixed-shape Postgres array, not JSONB — a set of selected option ids (plan §2
  // JSONB-vs-relational criteria: this is queried/compared, not an opaque blob).
  selectedOptionIds String[] @map("selected_option_ids")
  isCorrect         Boolean  @default(false) @map("is_correct")

  @@index([attemptId])
  @@map("quiz_attempt_answers")
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId            String   @map("quiz_id")
  quiz              Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizAttemptId     String   @unique @map("quiz_attempt_id")
  quizAttempt       QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  certificateNumber String   @unique @map("certificate_number")
  issuedAt          DateTime @default(now()) @map("issued_at")
  pdfUrl            String?  @map("pdf_url")
  revokedAt         DateTime? @map("revoked_at")

  @@index([userId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Notifications (Phase 5) — real-time + email fan-out support. `payload` is JSONB
// because its shape varies per notification_type and is read/written as a whole,
// never queried by internal fields (plan §2 JSONB-vs-relational criteria).
// ---------------------------------------------------------------------------

enum NotificationType {
  forum_reply
  blog_comment
  approval
  role_change
  certificate_issued
  security_alert
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Admin activity log (NEW) — the old app's "Recent Activity" dashboard table had
// no backend behind it at all (404 route, permanently empty). This is a real
// audit trail: every admin moderation/user-management action writes one row here.
// ---------------------------------------------------------------------------

enum AdminActivityAction {
  user_approved
  user_unapproved
  user_roles_changed
  user_deleted
  resource_approved
  recording_approved
  blog_approved
}

model AdminActivityLog {
  id         String   @id @default(uuid())
  // Nullable + SetNull: an admin's audit trail should survive their own account
  // being deleted later, rather than cascading the log rows away.
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AdminActivityAction
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action])
  @@map("admin_activity_logs")
}

// Singleton row (id fixed to "default") holding site-wide admin configuration —
// upserted, never multi-row, so there's no query/list surface for it.
model SiteSettings {
  id                        String   @id @default("default")
  siteName                  String   @default("PacketPulse") @map("site_name")
  siteDescription           String   @default("A community platform for networking professionals") @map("site_description")
  maintenanceMode           Boolean  @default(false) @map("maintenance_mode")
  registrationEnabled       Boolean  @default(true) @map("registration_enabled")
  maxUploadSizeMb           Int      @default(10) @map("max_upload_size_mb")
  maxUserResourcesCount     Int      @default(50) @map("max_user_resources_count")
  emailVerificationRequired Boolean  @default(true) @map("email_verification_required")
  adminEmail                String   @default("packetpulse25@gmail.com") @map("admin_email")
  apiRateLimit              Int      @default(100) @map("api_rate_limit")
  sessionTimeoutMinutes     Int      @default(60) @map("session_timeout_minutes")
  theme                     String   @default("dark")
  logLevel                  String   @default("error") @map("log_level")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

enum ClientLogLevel {
  debug
  info
  warn
  error
}

// Client-side error/event log ingestion — mirrors the legacy app's client-log
// pipeline (browser errors POSTed here, viewable by admins), now DB-backed
// instead of flat files.
model ClientLog {
  id        String         @id @default(uuid())
  level     ClientLogLevel
  context   String?
  message   String
  data      Json?
  userId    String?        @map("user_id")
  ip        String?
  userAgent String?        @map("user_agent")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([level])
  @@map("client_logs")
}
