# Copy to .env for local dev — never commit real values.

NODE_ENV=development
PORT=4000

# docker = local Postgres/Redis + custom JWT auth + Socket.IO realtime (this file's
# defaults). supabase = Supabase-hosted Postgres/Auth/Realtime/Storage — requires the
# SUPABASE_* vars below. Redis/BullMQ jobs are unaffected either way (platform-mode plan §1).
PLATFORM_MODE=docker

# Local dev: docker-compose.yml postgres service. Supabase mode: the Session Mode
# pooler connection string from Project Settings → Database → Connection pooling —
# NOT the direct db.<ref>.supabase.co host, which resolves IPv6-only and is
# unreachable from IPv4-only networks. Add ?connect_timeout=20 too: the pooler's
# extra hop needs longer than Prisma's default connect timeout on some routes.
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connect_timeout=20
DATABASE_URL=postgresql://packetpulse:packetpulse@localhost:5433/packetpulse

REDIS_URL=redis://localhost:6380

# Required only when PLATFORM_MODE=supabase — Project Settings → API in the Supabase
# dashboard. SUPABASE_SECRET_KEY is the current "secret key" (sb_secret_...), the
# replacement for the legacy service_role key — no JWT secret needed since our own
# JWT_ACCESS_SECRET still signs session tokens in both modes (plan §2).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Generate with: openssl rand -hex 32 — asserted non-empty at boot (plan §11)
ADMIN_SECURE_CODE=

# Comma-separated explicit allowlist — never "*" (plan §11)
CORS_ORIGINS=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
