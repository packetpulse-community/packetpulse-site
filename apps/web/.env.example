# Copy to .env.local for local dev — never commit real values.

# Server-only (SSR/Server Components call the backend directly, Node-to-Node).
API_INTERNAL_URL=http://localhost:4000

# Browser calls always go through the same-origin /api/* rewrite in next.config.mjs
# instead — no public API URL env var is needed for client-side requests.

# Must match the backend's PLATFORM_MODE — public because useRealtime.ts picks
# socket.io-client (docker) vs. supabase-js (supabase) client-side (platform-mode plan §1).
NEXT_PUBLIC_PLATFORM_MODE=docker

# Required only when NEXT_PUBLIC_PLATFORM_MODE=supabase. PUBLISHABLE_KEY is
# Supabase's current public-key name (sb_publishable_...), replacing the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
