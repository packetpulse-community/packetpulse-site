// Identity domain (Phase 1) — users, multi-role RBAC, and token/verification tables.
// Content domains (Phase 2) — blogs, resources, recordings.
// New features (Phase 3) — forums, quizzes/certificates (plan §2).
generator client {
  provider      = "prisma-client-js"
  // relationJoins lets a query load nested relations with one SQL statement (JOINs) instead of
  // one round trip per relation level; used for the user + roles + permissions lookup on
  // every authenticated request (user.prisma-repository.ts).
  previewFeatures = ["relationJoins"]
  // "native" for local dev; the musl-openssl-3.0.x engine is what Docker's
  // node:24-alpine runtime image needs (Alpine ships OpenSSL 3.x, not 1.1 —
  // the default musl target ships a libssl.so.1.1-linked engine that fails to
  // load at all on modern Alpine, caught by actually running the built
  // container, not just building it).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfessionalExperience {
  student
  junior
  mid
  senior
  lead
}

model User {
  id                     String    @id @default(uuid())
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  email                  String    @unique
  // Null for users whose credentials live in Supabase Auth instead of here
  // (PLATFORM_MODE=supabase — see CredentialProvider) — never null in docker mode.
  passwordHash           String?   @map("password_hash")
  whatsappNumber         String?   @map("whatsapp_number")
  professionalExperience ProfessionalExperience? @map("professional_experience")
  avatarUrl              String?   @map("avatar_url")
  bio                    String?

  // Approval is orthogonal to role — an unapproved user has no access regardless
  // of role (plan §4). Requires emailVerified before an admin can approve (plan §4).
  isApproved  Boolean   @default(false) @map("is_approved")
  approvedById String?  @map("approved_by_id")
  approvedBy   User?    @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]  @relation("UserApprovals")
  approvedAt   DateTime? @map("approved_at")

  emailVerified Boolean  @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  certifications      UserCertification[]
  socialLinks         UserSocialLinks?
  refreshTokens        RefreshToken[]
  passwordResets        PasswordReset[]
  emailVerifications     EmailVerification[]
  roles                 UserRole[]

  blogPosts            BlogPost[]
  blogComments         BlogComment[]
  blogLikes            BlogLike[]
  resources            Resource[]
  resourceLikes        ResourceLike[]
  recordingsAsInstructor Recording[]
  recordingParticipations RecordingParticipant[]
  recordingLikes       RecordingLike[]

  forumThreads         ForumThread[]
  forumReplies         ForumReply[]
  forumReplyLikes      ForumReplyLike[]
  quizzesCreated       Quiz[]
  quizAttempts         QuizAttempt[]
  certificates         Certificate[]
  notifications        Notification[]
  activityLogActions   AdminActivityLog[]

  @@map("users")
  storedFiles StoredFile[]
  notificationSettings    NotificationSettings?
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]
  notificationPreferenceChanges NotificationPreferenceChange[]
  memberSkills            MemberSkill[]
  skillSuggestions        SkillSuggestion[]
  skillSightings          SkillSuggestionSighting[]
}

model UserCertification {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  issueDate        DateTime? @map("issue_date")
  expiryDate       DateTime? @map("expiry_date")
  verificationUrl  String?   @map("verification_url")

  @@index([userId])
  @@map("user_certifications")
}

// Fixed known columns, not a free-form JSON blob — replaces the old Mongoose
// socialLinks{} ad hoc object (plan §2 JSONB-vs-relational criteria).
model UserSocialLinks {
  id        String @id @default(uuid())
  userId    String @unique @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedin  String?
  github    String?
  twitter   String?
  website   String?

  @@map("user_social_links")
}

// Refresh tokens are stored server-side as a hash (not a bare re-signed JWT like the
// old app) so they can be genuinely revoked, and rotated with reuse detection: presenting
// an already-rotated token revokes the whole family (replayAttack defense, plan §4).
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @map("token_hash")
  familyId      String    @map("family_id") // shared across a rotation chain — revoking one revokes the family
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedById  String?   @unique @map("replaced_by_id")
  replacedBy    RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  previousToken RefreshToken? @relation("TokenRotation")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

// OTP-based reset (6-digit, hashed, 10-minute expiry) — kept from the old app's UX,
// reimplemented against its own table instead of overloading columns on User (plan §4).
model PasswordReset {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_resets")
}

// New — the old app never verified email despite having an unused emailVerified field.
// Single-use, 24h-expiry, hashed token (plan §4).
model EmailVerification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("email_verifications")
}

// Multi-role RBAC — replaces the old flat member/admin enum. RolesGuard checks
// permissions, not raw role names, so adding a role later never touches guard logic,
// only role_permissions seed data (plan §4).
model Role {
  id          String    @id @default(uuid())
  name        String    @unique // member | moderator | instructor | admin | super_admin
  description String?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id   String @id @default(uuid())
  key  String @unique // e.g. "blogs:publish", "forums:moderate", "users:approve"

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A user can hold multiple roles at once (e.g. instructor + moderator), not just one (plan §4).
model UserRole {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Content domains (Phase 2): blogs, resources, recordings.
// Comments/likes/tags/participants are first-class join/child tables with FKs
// — no embedded arrays, replacing Mongoose's embedded-document pattern (plan §2).
// ---------------------------------------------------------------------------

// Shared across blog/resource/recording/forum content — one editable list rather
// than per-domain enums, so admins can add/rename/reorder categories without a
// schema change (replaces the old BlogCategory/ResourceCategory/RecordingCategory
// enums and the ForumCategory table).
model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  blogPosts  BlogPost[]
  resources  Resource[]
  recordings Recording[]
  quizzes    Quiz[]
  threads    ForumThread[]

  @@map("categories")
}

model BlogPost {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  content    String
  authorId   String   @map("author_id")
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  coverImageUrl String? @map("cover_image_url")
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])
  viewCount  Int      @default(0) @map("view_count")
  isPublished Boolean @default(true) @map("is_published")
  // Moderation gate, added alongside Resource/Recording's existing isApproved (same
  // default-true semantics — most posts pass through, admin moderation queue is
  // opt-in via manually flagging a post false, mirroring the resources/recordings
  // pattern rather than gating every new post behind approval).
  isApproved Boolean @default(true) @map("is_approved")
  postedAt   DateTime @default(now()) @map("posted_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tags     BlogPostTag[]
  images   BlogPostImage[]
  comments BlogComment[]
  likes    BlogLike[]

  @@index([categoryId])
  @@index([isPublished, postedAt])
  @@index([isApproved])
  @@map("blog_posts")
}

model BlogPostTag {
  blogPostId String   @map("blog_post_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        String

  @@id([blogPostId, tag])
  @@index([tag])
  @@map("blog_post_tags")
}

model BlogPostImage {
  id         String   @id @default(uuid())
  blogPostId String   @map("blog_post_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  url        String
  position   Int      @default(0)

  @@index([blogPostId])
  @@map("blog_post_images")
}

model BlogComment {
  id         String   @id @default(uuid())
  blogPostId String   @map("blog_post_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([blogPostId, createdAt])
  @@map("blog_comments")
}

model BlogLike {
  blogPostId String   @map("blog_post_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([blogPostId, userId])
  @@index([userId])
  @@map("blog_likes")
}

enum ResourceType {
  pdf
  video
  article
  tutorial
  diagram
  config_template
  tool
  external_link
}

model Resource {
  id             String   @id @default(uuid())
  title          String
  description    String
  resourceType   ResourceType @map("resource_type")
  categoryId     String   @map("category_id")
  category       Category @relation(fields: [categoryId], references: [id])
  fileUrl        String?  @map("file_url")
  externalLink   String?  @map("external_link")
  thumbnailUrl   String?  @map("thumbnail_url")
  downloadable   Boolean  @default(true)
  premium        Boolean  @default(false)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloads      Int      @default(0)
  views          Int      @default(0)
  isFeatured     Boolean  @default(false) @map("is_featured")
  isApproved     Boolean  @default(true) @map("is_approved")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tags  ResourceTag[]
  likes ResourceLike[]

  @@index([categoryId])
  @@index([resourceType])
  @@index([isApproved, premium])
  @@map("resources")
}

model ResourceTag {
  resourceId String   @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        String

  @@id([resourceId, tag])
  @@index([tag])
  @@map("resource_tags")
}

model ResourceLike {
  resourceId String   @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([resourceId, userId])
  @@index([userId])
  @@map("resource_likes")
}

model Recording {
  id             String   @id @default(uuid())
  title          String
  description    String
  recordingUrl   String   @map("recording_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  durationSeconds Int     @default(0) @map("duration_seconds")
  categoryId     String   @map("category_id")
  category       Category @relation(fields: [categoryId], references: [id])
  instructorId   String   @map("instructor_id")
  instructor     User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  premium        Boolean  @default(false)
  isFeatured     Boolean  @default(true) @map("is_featured")
  isApproved     Boolean  @default(true) @map("is_approved")
  views          Int      @default(0)
  recordedAt     DateTime @default(now()) @map("recorded_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tags         RecordingTag[]
  participants RecordingParticipant[]
  likes        RecordingLike[]

  @@index([categoryId])
  @@index([isApproved, premium])
  @@map("recordings")
}

model RecordingTag {
  recordingId String    @map("recording_id")
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  tag         String

  @@id([recordingId, tag])
  @@index([tag])
  @@map("recording_tags")
}

model RecordingParticipant {
  recordingId String    @map("recording_id")
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now()) @map("joined_at")

  @@id([recordingId, userId])
  @@index([userId])
  @@map("recording_participants")
}

model RecordingLike {
  recordingId String    @map("recording_id")
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([recordingId, userId])
  @@index([userId])
  @@map("recording_likes")
}

// ---------------------------------------------------------------------------
// Forums (Phase 3, NEW) — no backend model ever existed for this in the old app,
// designed from scratch (plan §2/§3).
// ---------------------------------------------------------------------------

model ForumThread {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])
  authorId    String   @map("author_id")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  content     String
  slug        String
  isPinned    Boolean  @default(false) @map("is_pinned")
  isLocked    Boolean  @default(false) @map("is_locked")
  viewCount   Int      @default(0) @map("view_count")
  // Denormalized cache, recomputable from replies.count — not authoritative state (plan §2).
  replyCount  Int      @default(0) @map("reply_count")
  lastReplyAt DateTime @default(now()) @map("last_reply_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  replies ForumReply[]

  @@unique([categoryId, slug])
  @@index([categoryId, lastReplyAt])
  @@map("forum_threads")
}

model ForumReply {
  id             String   @id @default(uuid())
  threadId       String   @map("thread_id")
  thread         ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId       String   @map("author_id")
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  parentReplyId  String?  @map("parent_reply_id")
  parentReply    ForumReply?  @relation("ReplyNesting", fields: [parentReplyId], references: [id], onDelete: SetNull)
  childReplies   ForumReply[] @relation("ReplyNesting")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  editedAt       DateTime? @map("edited_at")

  likes ForumReplyLike[]

  @@index([threadId, createdAt])
  @@map("forum_replies")
}

model ForumReplyLike {
  replyId   String     @map("reply_id")
  reply     ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@id([replyId, userId])
  @@index([userId])
  @@map("forum_reply_likes")
}

// ---------------------------------------------------------------------------
// Quizzes/Certificates (Phase 3, NEW) — old app only had leftover admin-cleanup
// references to a "quizzes" data type; no real feature ever existed. Designed
// from scratch (plan §2/§3).
// ---------------------------------------------------------------------------

enum QuizQuestionType {
  single_choice
  multi_choice
}

enum QuizAttemptStatus {
  in_progress
  submitted
  expired
}

model Quiz {
  id                String   @id @default(uuid())
  title             String
  description       String
  categoryId        String   @map("category_id")
  category          Category @relation(fields: [categoryId], references: [id])
  passingScorePct   Int      @default(70) @map("passing_score_pct")
  timeLimitSeconds  Int?     @map("time_limit_seconds")
  // Assessment integrity (TASK-032, S-7). maxAttempts null = unlimited. retakeGapSeconds is
  // the minimum wait between the end of one attempt and the start of the next. expiresAt
  // stops new attempts from starting after that moment. archivedAt retires a quiz that
  // has issued certificates (those can never be deleted with it, D-1/S-9).
  maxAttempts       Int?     @default(3) @map("max_attempts")
  retakeGapSeconds  Int      @default(0) @map("retake_gap_seconds")
  expiresAt         DateTime? @map("expires_at")
  archivedAt        DateTime? @map("archived_at")
  isPublished       Boolean  @default(false) @map("is_published")
  createdById       String   @map("created_by_id")
  createdBy         User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  certificates Certificate[]

  @@index([isPublished, categoryId])
  @@map("quizzes")
}

model QuizQuestion {
  id           String   @id @default(uuid())
  quizId       String   @map("quiz_id")
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String   @map("question_text")
  questionType QuizQuestionType @map("question_type")
  position     Int      @default(0)
  points       Int      @default(1)

  options QuizQuestionOption[]
  answers QuizAttemptAnswer[]

  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizQuestionOption {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String   @map("option_text")
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int      @default(0)

  @@index([questionId])
  @@map("quiz_question_options")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String   @map("quiz_id")
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now()) @map("started_at")
  // Fixed when the attempt starts (startedAt + the quiz's time limit at that moment), so a
  // later edit of the limit cannot move the deadline of an attempt already running.
  deadlineAt  DateTime? @map("deadline_at")
  submittedAt DateTime? @map("submitted_at")
  scorePct    Int?     @map("score_pct")
  passed      Boolean?
  status      QuizAttemptStatus @default(in_progress)

  answers     QuizAttemptAnswer[]
  certificate Certificate?

  @@index([userId, quizId])
  @@index([status])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id                String   @id @default(uuid())
  attemptId         String   @map("attempt_id")
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String   @map("question_id")
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Fixed-shape Postgres array, not JSONB — a set of selected option ids (plan §2
  // JSONB-vs-relational criteria: this is queried/compared, not an opaque blob).
  selectedOptionIds String[] @map("selected_option_ids")
  isCorrect         Boolean  @default(false) @map("is_correct")

  @@index([attemptId])
  @@map("quiz_attempt_answers")
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId            String   @map("quiz_id")
  // NoAction (not Cascade): a quiz, or an attempt, that backs a certificate cannot be
  // deleted out from under it. The check runs at the end of the statement, so deleting
  // the holder's whole account (user cascade) still works.
  quiz              Quiz     @relation(fields: [quizId], references: [id], onDelete: NoAction)
  quizAttemptId     String   @unique @map("quiz_attempt_id")
  quizAttempt       QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: NoAction)
  certificateNumber String   @unique @map("certificate_number")
  issuedAt          DateTime @default(now()) @map("issued_at")
  pdfUrl            String?  @map("pdf_url")
  revokedAt         DateTime? @map("revoked_at")

  @@index([userId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Notifications (Phase 5) — real-time + email fan-out support. `payload` is JSONB
// because its shape varies per notification_type and is read/written as a whole,
// never queried by internal fields (plan §2 JSONB-vs-relational criteria).
// ---------------------------------------------------------------------------

enum NotificationType {
  forum_reply
  blog_comment
  approval
  role_change
  certificate_issued
  security_alert
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Notification service (TASK-021, PRD-041, DB-024). Event types are plain strings validated
// against the catalogue in packages/types (the v2 events have no emitter yet, so they are
// not in the NotificationType enum above). Personal data: the WhatsApp number is the
// member's own and is only ever returned to them.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  in_app
  email
  whatsapp
}

enum NotificationDeliveryStatus {
  queued
  sent
  delivered
  failed
  skipped
}

enum DigestFrequency {
  off
  daily
  weekly
}

// One row per member, event type and channel the member has explicitly chosen. No row = the
// catalogue default applies.
model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String              @map("event_type")
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

// Per-member settings: quiet hours, digest, marketing opt-in, WhatsApp opt-in.
model NotificationSettings {
  userId                        String          @id @map("user_id")
  user                          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quietHoursEnabled             Boolean         @default(true) @map("quiet_hours_enabled")
  quietHoursStart               String          @default("21:00") @map("quiet_hours_start")
  quietHoursEnd                 String          @default("08:00") @map("quiet_hours_end")
  timezone                      String          @default("Asia/Kolkata")
  digestFrequency               DigestFrequency @default(off) @map("digest_frequency")
  // Separate from every event preference: marketing is never implied by an account.
  marketingOptIn                Boolean         @default(false) @map("marketing_opt_in")
  marketingOptInAt              DateTime?       @map("marketing_opt_in_at")
  whatsappOptIn                 Boolean         @default(false) @map("whatsapp_opt_in")
  whatsappOptInAt               DateTime?       @map("whatsapp_opt_in_at")
  whatsappNumber                String?         @map("whatsapp_number")
  whatsappNumberRequestedAt     DateTime?       @map("whatsapp_number_requested_at")
  whatsappNumberConfirmedAt     DateTime?       @map("whatsapp_number_confirmed_at")
  updatedAt                     DateTime        @updatedAt @map("updated_at")

  @@map("notification_settings")
}

// Every decision the dispatcher makes, for every channel, including "skipped" (with a reason
// code). errorSummary never holds an address, body or number. notificationId is null for
// messages with no in-app row (email-only sends). Retention: purge by createdAt.
model NotificationDelivery {
  id             String                     @id @default(uuid())
  userId         String                     @map("user_id")
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String?                    @map("notification_id")
  notification   Notification?              @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  eventType      String                     @map("event_type")
  channel        NotificationChannel
  status         NotificationDeliveryStatus
  reasonCode     String?                    @map("reason_code")
  critical       Boolean                    @default(false)
  attempts       Int                        @default(0)
  errorSummary   String?                    @map("error_summary")
  scheduledFor   DateTime?                  @map("scheduled_for")
  sentAt         DateTime?                  @map("sent_at")
  deliveredAt    DateTime?                  @map("delivered_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([userId, channel, createdAt])
  @@index([notificationId])
  @@map("notification_deliveries")
}

// Who changed which preference and when (SCR-037: every change is recorded with a time).
model NotificationPreferenceChange {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notification_preference_changes")
}

// ---------------------------------------------------------------------------
// Admin activity log (NEW) — the old app's "Recent Activity" dashboard table had
// no backend behind it at all (404 route, permanently empty). This is a real
// audit trail: every admin moderation/user-management action writes one row here.
// ---------------------------------------------------------------------------

enum AdminActivityAction {
  user_approved
  user_unapproved
  user_roles_changed
  user_deleted
  resource_approved
  resource_unapproved
  recording_approved
  recording_unapproved
  blog_approved
  blog_unapproved
  forum_thread_locked
  forum_thread_unlocked
  forum_thread_pinned
  forum_thread_unpinned
  forum_thread_deleted
  quiz_created
  quiz_updated
  quiz_deleted
  user_data_cleaned
  users_data_bulk_cleaned
  site_settings_changed
  admin_registered
  category_created
  category_updated
  category_deleted
  categories_reordered
  blog_deleted
  blog_comment_deleted
  resource_deleted
  recording_deleted
  forum_reply_deleted
  skill_created
  skill_updated
  skill_retired
  skill_restored
  skill_alias_added
  skill_alias_removed
  skill_suggestion_added
  skill_suggestion_merged
  skill_suggestion_rejected
  skill_suggestion_auto_merged
}

model AdminActivityLog {
  id         String   @id @default(uuid())
  // Nullable + SetNull: an admin's audit trail should survive their own account
  // being deleted later, rather than cascading the log rows away.
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AdminActivityAction
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?
  // Why the staff member did it. Required (min 10 chars, enforced in the API) for the
  // destructive actions; nullable because older rows and routine actions have none.
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Append-only: a database trigger (migration 20261116100000_audit_log_append_only)
  // rejects UPDATE and DELETE; the only allowed change is actor_id -> NULL (SetNull FK).
  @@index([createdAt])
  @@index([action])
  @@map("admin_activity_logs")
}

// Singleton row (id fixed to "default") holding site-wide admin configuration —
// upserted, never multi-row, so there's no query/list surface for it.
model SiteSettings {
  id                        String   @id @default("default")
  siteName                  String   @default("PacketPulse") @map("site_name")
  siteDescription           String   @default("A community platform for networking professionals") @map("site_description")
  maintenanceMode           Boolean  @default(false) @map("maintenance_mode")
  registrationEnabled       Boolean  @default(true) @map("registration_enabled")
  maxUploadSizeMb           Int      @default(10) @map("max_upload_size_mb")
  maxUserResourcesCount     Int      @default(50) @map("max_user_resources_count")
  emailVerificationRequired Boolean  @default(true) @map("email_verification_required")
  adminEmail                String   @default("packetpulse25@gmail.com") @map("admin_email")
  apiRateLimit              Int      @default(100) @map("api_rate_limit")
  sessionTimeoutMinutes     Int      @default(60) @map("session_timeout_minutes")
  theme                     String   @default("dark")
  logLevel                  String   @default("error") @map("log_level")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

enum ClientLogLevel {
  debug
  info
  warn
  error
}

// Client-side error/event log ingestion — mirrors the legacy app's client-log
// pipeline (browser errors POSTed here, viewable by admins), now DB-backed
// instead of flat files.
model ClientLog {
  id        String         @id @default(uuid())
  level     ClientLogLevel
  context   String?
  message   String
  data      Json?
  userId    String?        @map("user_id")
  ip        String?
  userAgent String?        @map("user_agent")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([level])
  @@map("client_logs")
}

// ---- Private files (TASK-014, SEC-03, PRD-046) ----
enum StoredFileKind {
  resume
  certificate
  evidence
}

enum StoredFileStatus {
  pending
  available
  rejected
  deleted
}

enum FileAccessAction {
  upload_url
  complete
  open
  delete
  denied
}

// Metadata for an object in the PRIVATE storage bucket. The bytes never touch our server.
model StoredFile {
  id           String           @id @default(uuid())
  ownerId      String           @map("owner_id")
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind         StoredFileKind
  originalName String           @map("original_name")
  contentType  String           @map("content_type")
  sizeBytes    Int              @map("size_bytes")
  bucket       String
  path         String
  status       StoredFileStatus @default(pending)
  scanResult   String?          @map("scan_result")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([status, createdAt])
  @@map("stored_files")
}

// Append-only (a database trigger refuses UPDATE/DELETE). file_id and actor_id are plain
// columns, not foreign keys, so the trail survives deleting the file or the account.
model FileAccessLog {
  id        String           @id @default(uuid())
  fileId    String           @map("file_id")
  actorId   String?          @map("actor_id")
  action    FileAccessAction
  ip        String?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([fileId, createdAt])
  @@index([actorId])
  @@map("file_access_logs")
}

// ---------------------------------------------------------------------------------------------
// TASK-027 skill taxonomy (PRD-011, DEC-014, DB-006..008). Major > Minor > Micro tree owned by
// admins. `Category` stays a content classifier; skills are a separate model on purpose.
// ---------------------------------------------------------------------------------------------

enum SkillLevel {
  major
  minor
  micro
}

enum SkillStatus {
  active
  retired
}

enum SkillSuggestionStatus {
  pending
  merged
  added
  rejected
}

enum SkillVisibility {
  public
  members
  private
}

// Singleton ("default"): the taxonomy version, bumped in the same transaction as every
// admin change, and the number of distinct sightings at which a clear match auto-merges.
model SkillTaxonomyState {
  id                 String   @id @default("default")
  version            Int      @default(1)
  autoMergeThreshold Int      @default(10) @map("auto_merge_threshold")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("skill_taxonomy_state")
}

model Skill {
  id          String      @id @default(uuid())
  name        String
  // Lower-cased, whitespace-collapsed name: unique, so "OSPF" and "ospf " collide (DB-006).
  nameKey     String      @unique @map("name_key")
  // Letters and digits only: "OSPF v2" and "ospfv2" share it. Used for clear-match detection.
  matchKey    String      @map("match_key")
  level       SkillLevel
  parentId    String?     @map("parent_id")
  parent      Skill?      @relation("SkillTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Skill[]     @relation("SkillTree")
  description String?
  status      SkillStatus @default(active)
  position    Int         @default(0)
  retiredAt   DateTime?   @map("retired_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  aliases     SkillAlias[]
  members     MemberSkill[]
  suggestions SkillSuggestion[] @relation("SuggestionResolvedSkill")

  @@index([parentId])
  @@index([level, status])
  @@index([matchKey])
  @@map("skills")
}

model SkillAlias {
  id       String @id @default(uuid())
  skillId  String @map("skill_id")
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  alias    String
  aliasKey String @unique @map("alias_key")
  matchKey String @map("match_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([skillId])
  @@index([matchKey])
  @@map("skill_aliases")
}

// DB-007: a name a member typed that is not in the taxonomy yet. One row per normalised
// name; `sightings` counts distinct members (SkillSuggestionSighting).
model SkillSuggestion {
  id            String                @id @default(uuid())
  name          String
  nameKey       String                @unique @map("name_key")
  matchKey      String                @map("match_key")
  status        SkillSuggestionStatus @default(pending)
  sightings     Int                   @default(1)
  // Set when the matchKey equals an existing skill or alias: the auto-merge target.
  matchSkillId  String?               @map("match_skill_id")
  suggestedById String?               @map("suggested_by_id")
  suggestedBy   User?                 @relation(fields: [suggestedById], references: [id], onDelete: SetNull)
  resolvedSkillId String?             @map("resolved_skill_id")
  resolvedSkill Skill?                @relation("SuggestionResolvedSkill", fields: [resolvedSkillId], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?             @map("resolved_at")
  rejectReason  String?               @map("reject_reason")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  sightingRows SkillSuggestionSighting[]

  @@index([status, sightings])
  @@map("skill_suggestions")
}

model SkillSuggestionSighting {
  suggestionId String          @map("suggestion_id")
  suggestion   SkillSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@id([suggestionId, userId])
  @@map("skill_suggestion_sightings")
}

// DB-008: a skill a member claims. One per member and skill. Always "self declared" until
// the evidence model (TASK-033) exists, so there is no label column yet.
model MemberSkill {
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId    String          @map("skill_id")
  skill      Skill           @relation(fields: [skillId], references: [id], onDelete: Restrict)
  visibility SkillVisibility @default(members)
  createdAt  DateTime        @default(now()) @map("created_at")

  @@id([userId, skillId])
  @@index([skillId])
  @@map("member_skills")
}
