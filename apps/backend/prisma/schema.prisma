// Placeholder schema for Phase 0 bootstrap — real domain models land in Phase 1
// (users/roles/permissions/tokens) and subsequent phases (see migration plan §2).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}
