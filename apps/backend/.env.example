# Copy to .env for local dev — never commit real values.

NODE_ENV=development
PORT=4000

# Local dev: docker-compose.yml postgres service. Production/staging: Supabase-cloud
# connection string, later swappable to a self-hosted Postgres Docker DNS name
# (postgres://user:pass@postgres:5432/packetpulse) with no code changes — see plan §8.
DATABASE_URL=postgresql://packetpulse:packetpulse@localhost:5433/packetpulse

REDIS_URL=redis://localhost:6380

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Generate with: openssl rand -hex 32 — asserted non-empty at boot (plan §11)
ADMIN_SECURE_CODE=

# Comma-separated explicit allowlist — never "*" (plan §11)
CORS_ORIGINS=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
